GEMINI_API_KEY=
# Optional — a second Gemini key used when the first one's quota runs out or
# it stops working. Create it in a different Google Cloud project (or Google
# account): keys in the same project share one quota.
GEMINI_API_KEY_BACKUP=
# Optional — only needed if you want Claude Sonnet 5 as the last fallback
# step after the Gemini models. Leave blank to skip it entirely.
ANTHROPIC_API_KEY=
